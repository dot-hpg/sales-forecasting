  <dashboards>
    <dashboard name='Sales Forecasting Dashboard'>
      <style><style-rule element='table'><format attr='background-color' value='#F3F5F9' /></style-rule></style>
      <size maxheight='2336' maxwidth='1400' minheight='2336' minwidth='1400' />
      <zones><zone h='100000' id='1' type='layout-basic' w='100000' x='0' y='0'><zone h='4795' id='10' w='72309' x='1143' y='685' type='text'><formatted-text><run bold='true' fontcolor='#FFFFFF' fontsize='26'>Product Sales Forecasting</run><run>Æ&#10;</run><run fontcolor='#C9D6EA' fontsize='11'>365 retail stores · 4 formats · 5 location types · 4 regions · daily sales Jan 2018 – May 2019 · 61-day LightGBM forecast for Jun – Jul 2019</run></formatted-text><zone-style><format attr='border-style' value='none' /><format attr='margin' value='5' /><format attr='padding' value='18' /><format attr='background-color' value='#1F3B73' /></zone-style></zone><zone h='4795' id='11' w='25406' x='73451' y='685' type='text'><formatted-text><run fontcolor='#C9D6EA' fontsize='9'>Guntuku Hariprasad · Data science portfolio</run><run>Æ&#10;</run><run fontcolor='#FFFFFF' fontsize='9'>github.com/dot-hpg/sales-forecasting</run></formatted-text><zone-style><format attr='border-style' value='none' /><format attr='margin' value='5' /><format attr='padding' value='18' /><format attr='background-color' value='#1F3B73' /></zone-style></zone><zone h='257' id='12' w='97714' x='1143' y='5822' type='empty'><zone-style><format attr='border-style' value='none' /><format attr='margin' value='0' /><format attr='background-color' value='#EB6834' /></zone-style></zone><zone h='5051' id='13' w='16286' x='1143' y='6421' name='KPI Total Sales'><zone-style><format attr='border-color' value='#E1E6EF' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='5' /><format attr='padding' value='10' /><format attr='background-color' value='#FFFFFF' /></zone-style></zone><zone h='5051' id='14' w='16286' x='17429' y='6421' name='KPI Avg Store Day'><zone-style><format attr='border-color' value='#E1E6EF' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='5' /><format attr='padding' value='10' /><format attr='background-color' value='#FFFFFF' /></zone-style></zone><zone h='5051' id='15' w='16286' x='33714' y='6421' name='KPI Discount Uplift'><zone-style><format attr='border-color' value='#E1E6EF' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='5' /><format attr='padding' value='10' /><format attr='background-color' value='#FFFFFF' /></zone-style></zone><zone h='5051' id='16' w='16286' x='50000' y='6421' name='KPI Holiday Effect'><zone-style><format attr='border-color' value='#E1E6EF' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='5' /><format attr='padding' value='10' /><format attr='background-color' value='#FFFFFF' /></zone-style></zone><zone h='5051' id='17' w='16286' x='66286' y='6421' name='KPI Hold-out WAPE'><zone-style><format attr='border-color' value='#E1E6EF' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='5' /><format attr='padding' value='10' /><format attr='background-color' value='#FFFFFF' /></zone-style></zone><zone h='5051' id='18' w='16286' x='82571' y='6421' name='KPI Forecast'><zone-style><format attr='border-color' value='#E1E6EF' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='5' /><format attr='padding' value='10' /><format attr='background-color' value='#FFFFFF' /></zone-style></zone><zone h='2226' id='19' w='97714' x='1143' y='11815' type='text'><formatted-text><run bold='true' fontcolor='#1F3B73' fontsize='15'>1  Sales performance</run><run fontcolor='#6B7A90' fontsize='10'>   How sales moved over time, and where they come from</run></formatted-text><zone-style><format attr='border-style' value='none' /><format attr='margin' value='5' /><format attr='padding' value='10' /></zone-style></zone><zone h='17123' id='20' w='62537' x='1143' y='14384' name='Sales Trend'><zone-style><format attr='border-color' value='#E1E6EF' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='5' /><format attr='padding' value='10' /><format attr='background-color' value='#FFFFFF' /></zone-style></zone><zone h='17123' id='21' w='35177' x='63680' y='14384' name='Sales Treemap'><zone-style><format attr='border-color' value='#E1E6EF' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='5' /><format attr='padding' value='10' /><format attr='background-color' value='#FFFFFF' /></zone-style></zone><zone h='14127' id='22' w='54720' x='1143' y='31849' name='Seasonality Heatmap'><zone-style><format attr='border-color' value='#E1E6EF' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='5' /><format attr='padding' value='10' /><format attr='background-color' value='#FFFFFF' /></zone-style></zone><zone h='14127' id='23' w='42994' x='55863' y='31849' name='Weekday Pattern'><zone-style><format attr='border-color' value='#E1E6EF' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='5' /><format attr='padding' value='10' /><format attr='background-color' value='#FFFFFF' /></zone-style></zone><zone h='2226' id='24' w='97714' x='1143' y='46318' type='text'><formatted-text><run bold='true' fontcolor='#1F3B73' fontsize='15'>2  What drives sales</run><run fontcolor='#6B7A90' fontsize='10'>   Store format, location and discounts</run></formatted-text><zone-style><format attr='border-style' value='none' /><format attr='margin' value='5' /><format attr='padding' value='10' /></zone-style></zone><zone h='14555' id='25' w='33223' x='1143' y='48887' name='Store Type x Location'><zone-style><format attr='border-color' value='#E1E6EF' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='5' /><format attr='padding' value='10' /><format attr='background-color' value='#FFFFFF' /></zone-style></zone><zone h='14555' id='26' w='35177' x='34366' y='48887' name='Discount by Store Type'><zone-style><format attr='border-color' value='#E1E6EF' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='5' /><format attr='padding' value='10' /><format attr='background-color' value='#FFFFFF' /></zone-style></zone><zone h='14555' id='27' w='29314' x='69543' y='48887' name='Uplift by Location'><zone-style><format attr='border-color' value='#E1E6EF' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='5' /><format attr='padding' value='10' /><format attr='background-color' value='#FFFFFF' /></zone-style></zone><zone h='2226' id='28' w='97714' x='1143' y='63784' type='text'><formatted-text><run bold='true' fontcolor='#1F3B73' fontsize='15'>3  Forecast quality</run><run fontcolor='#6B7A90' fontsize='10'>   Tested on Apr–May 2019 before forecasting Jun–Jul</run></formatted-text><zone-style><format attr='border-style' value='none' /><format attr='margin' value='5' /><format attr='padding' value='10' /></zone-style></zone><zone h='14127' id='29' w='97714' x='1143' y='66353' name='Forecast Window'><zone-style><format attr='border-color' value='#E1E6EF' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='5' /><format attr='padding' value='10' /><format attr='background-color' value='#FFFFFF' /></zone-style></zone><zone h='15411' id='30' w='29314' x='1143' y='80822' name='Holdout Scatter'><zone-style><format attr='border-color' value='#E1E6EF' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='5' /><format attr='padding' value='10' /><format attr='background-color' value='#FFFFFF' /></zone-style></zone><zone h='15411' id='31' w='24429' x='30457' y='80822' name='WAPE by Store Type'><zone-style><format attr='border-color' value='#E1E6EF' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='5' /><format attr='padding' value='10' /><format attr='background-color' value='#FFFFFF' /></zone-style></zone><zone h='15411' id='32' w='43971' x='54886' y='80822' name='Model Leaderboard'><zone-style><format attr='border-color' value='#E1E6EF' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='5' /><format attr='padding' value='10' /><format attr='background-color' value='#FFFFFF' /></zone-style></zone><zone h='2740' id='33' w='97714' x='1143' y='96575' type='text'><formatted-text><run fontcolor='#6B7A90' fontsize='9'>Final model: global LightGBM on log sales with 61-day-shifted lags, so no information leaks from the period being forecast. </run><run>Æ&#10;</run><run fontcolor='#6B7A90' fontsize='9'>Cross-validated WAPE 15.3% vs 22.8% for a seasonal naive baseline; hold-out store-day WAPE 16.8%, store-total WAPE 10.5%. WAPE = Σ|forecast − actual| ÷ Σ actual.</run></formatted-text><zone-style><format attr='border-style' value='none' /><format attr='margin' value='5' /><format attr='padding' value='10' /></zone-style></zone><zone-style><format attr='border-style' value='none' /><format attr='margin' value='0' /></zone-style></zone></zones>
      <simple-id uuid='{695BBA5A-B527-5CE3-8C14-8C543160EE7A}' />
