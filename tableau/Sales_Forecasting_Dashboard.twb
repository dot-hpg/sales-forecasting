    <worksheet name='Sales Trend'>
      <layout-options>
        <title>
          <formatted-text><run bold='true' fontcolor='#1B2433' fontsize='12'>Weekly sales: 17 months of actuals, then a 61-day forecast</run><run>Æ&#10;</run><run fontcolor='#6B7A90' fontsize='9'>Average daily chain sales per week. Blue = actual, orange = forecast; they overlap in Apr–May 2019, the hold-out test</run></formatted-text>
        </title>
      </layout-options>
      <table>
